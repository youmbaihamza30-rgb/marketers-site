# رابط ومفاتيح مشروع Supabase (من إعدادات المشروع > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# اسم الـ bucket في Supabase Storage (سننشئه بنفس هذا الاسم) - يجب أن يبدأ بـ NEXT_PUBLIC_ لأن المتصفح يستخدمه أيضاً عند الرفع المباشر
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

# سلسلة عشوائية طويلة وسرية، تُستخدم لتوقيع كوكيز الجلسة - غيّرها قبل النشر
SESSION_SECRET=change-this-to-a-long-random-string

# كلمتا المرور الابتدائيتان (سيتم تشفيرهما وتخزينهما في قاعدة البيانات عند أول تشغيل)
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_MARKETER_PASSWORD=marketer123
